{
  "name": "cherry-electron",
  "version": "1.7.0-electron.0",
  "private": true,
  "description": "Experimental Electron fork of Cherry",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run && node --test electron/*.test.mjs",
    "test:smoke": "npm run build && electron . --smoke-test",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^22.20.3",
    "jsdom": "^30.1.2",
    "svelte-check": "^4.3.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "@fontsource-variable/gabarito": "^5.3.0",
    "boxicons": "^2.1.4",
    "dashjs": "^5.2.1",
    "hls.js": "^1.7.3",
    "svelte": "^5.57.0",
    "youtubei.js": "^18.0.0"
  },
  "productName": "Cherry Electron",
  "main": "electron/main.mjs",
  "author": "inane.tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/inane-tools/cherry-electron.git"
  },
  "build": {
    "appId": "tools.inane.cherry.electron",
    "productName": "Cherry Electron",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.mjs",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "electron/assets/icon.png",
      "category": "AudioVideo"
    }
  }
}
