{
  "name": "cherry",
  "version": "1.6.2",
  "private": true,
  "description": "Lightweight YouTube Music desktop client",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:linux": "bash scripts/linux-session.sh npm run tauri -- dev",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run && node --test scripts/updater-manifest.test.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/gabarito": "^5.3.0",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-global-shortcut": "^2.2.1",
    "@tauri-apps/plugin-opener": "^2.4.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.3.1",
    "@tauri-apps/plugin-updater": "~2.11.0",
    "boxicons": "^2.1.4",
    "svelte": "^5.57.0",
    "youtubei.js": "^18.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.1.12",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.20.3",
    "jsdom": "^30.1.2",
    "svelte-check": "^4.3.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
