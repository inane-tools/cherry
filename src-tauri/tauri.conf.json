{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cherry",
  "version": "1.7.0",
  "identifier": "com.cherry.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Cherry",
        "width": 1120,
        "height": 720,
        "minWidth": 420,
        "minHeight": 480,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Music",
    "shortDescription": "Lightweight YouTube Music client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCRDc0MUE5NjM3MTdGMTAKUldRUWYzRmpxVUhYbTl6cFM3RVJTVkl6aFhONW05SFN2RG1TdXZGU0FSRzB3clBUcDNCUjcwZlcK",
      "endpoints": [
        "https://github.com/inane-tools/cherry/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
